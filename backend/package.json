{
  "name": "gobook-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "predev": "node scripts/ensureLocalMongo.mjs",
    "dev": "node --watch src/server.js",
    "prestart": "node scripts/ensureLocalMongo.mjs",
    "start": "node src/server.js",
    "start:production": "node scripts/startProduction.js",
    "package:upload": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/createUploadZip.ps1",
    "test": "node scripts/runTests.js",
    "test:inventory:integration": "node scripts/runTests.js tests/inventoryTransactions.integration.test.js",
    "seed:plans": "node scripts/seedSubscriptionPlans.js",
    "check:razorpay": "node scripts/checkRazorpaySetup.js",
    "security:migrate": "node scripts/hardenAuthenticationData.js",
    "seed:employee-month": "node scripts/seedEmployeePortalMonthDemo.mjs",
    "check:production": "node scripts/checkProductionConfig.js",
    "check:deployment": "node scripts/checkDeployment.js",
    "check:imports": "node scripts/checkImports.js",
    "check:http": "node scripts/checkHttpSmoke.js",
    "check:employee-local": "node scripts/verifyLocalEmployeePages.mjs",
    "migrate:gridfs": "node scripts/migrateUploadsToGridfs.js",
    "subscriptions:maintain": "node scripts/runSubscriptionMaintenance.js",
    "verify:admin-features": "node scripts/verifyAdminFeatures.js",
    "inventory:audit": "node scripts/auditInventoryConnectivity.js",
    "database:baseline": "node scripts/databaseBaseline.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "express": "^4.22.3",
    "google-auth-library": "^10.9.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.3",
    "luxon": "^3.7.2",
    "mongoose": "^8.9.5",
    "morgan": "^1.10.0",
    "multer": "^2.5.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.3.1",
    "pdfkit": "^0.20.2"
  },
  "devDependencies": {
    "pdfjs-dist": "^6.3.289"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1",
      "fast-csv": "^5.0.8"
    },
    "archiver-utils": {
      "glob": "^14.0.3"
    },
    "express": {
      "body-parser": "^1.20.9"
    },
    "minimatch": "^11.0.4"
  }
}
