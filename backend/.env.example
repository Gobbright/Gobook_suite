NODE_ENV=development
PORT=5000

CLIENT_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
META_PUBLIC_ORIGIN=http://localhost:5000

MONGODB_URI=mongodb://127.0.0.1:27017/gobook?replicaSet=rs0
MONGODB_DB_NAME=gobook
JWT_SECRET=replace-with-a-random-secret
ADMIN_LOGIN_ID=admin
ADMIN_LOGIN_PASSWORD=replace-with-your-admin-password

TURNSTILE_ENABLED=false
TURNSTILE_HOSTNAMES=localhost,127.0.0.1

# Live origins (enable when deploying):
# CLIENT_URL=https://gobooksuite.com
# FRONTEND_URL=https://gobooksuite.com
# ALLOWED_ORIGINS=https://gobooksuite.com,https://www.gobooksuite.com
# META_PUBLIC_ORIGIN=https://api.gobooksuite.com
# TURNSTILE_HOSTNAMES=gobooksuite.com,www.gobooksuite.com
